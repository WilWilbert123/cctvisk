{
  "general": {
    "app_name": "CCTV Network Discovery & Recovery Assistant",
    "theme": "system",
    "auto_refresh_dashboard_seconds": 15,
    "require_scan_authorization_confirm": true
  },
  "network_scan": {
    "default_timeout_ms": 800,
    "max_concurrency": 64,
    "port_scan_timeout_ms": 600,
    "enable_arp": true,
    "enable_icmp": true,
    "enable_tcp_probe": true,
    "enable_onvif": true,
    "enable_mdns": true,
    "enable_ssdp": true,
    "onvif_timeout_seconds": 3.0,
    "mdns_timeout_seconds": 2.5,
    "ssdp_timeout_seconds": 2.5
  },
  "monitoring": {
    "enabled": true,
    "interval_seconds": 60,
    "timeout_ms": 1000,
    "alert_on_offline": true,
    "alert_on_reconnect": true
  },
  "security": {
    "allow_lan_access": false,
    "require_token_for_lan": true,
    "session_timeout_minutes": 480,
    "rate_limit_per_minute": 120,
    "vault_encryption_algorithm": "Fernet-AES128-CBC-HMAC-SHA256"
  },
  "streaming": {
    "max_fps": 15,
    "jpeg_quality": 5,
    "idle_timeout_seconds": 45,
    "prefer_substream_for_grid": true
  }
}

