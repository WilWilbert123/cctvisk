# ============================================================================
# CCTV NETWORK DISCOVERY & RECOVERY ASSISTANT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values for your local environment.
# NEVER commit your actual .env file or secrets to version control.
# ============================================================================

# Application Settings
APP_NAME="CCTV Network Discovery & Recovery Assistant"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=false

# Server Binding
# Keep HOST=127.0.0.1 for local-only access.
# Set ALLOW_LAN_ACCESS=true and HOST=0.0.0.0 ONLY when accessing from an
# authorized mobile/desktop device on the same private Wi-Fi/LAN.
HOST=127.0.0.1
PORT=8000
ALLOW_LAN_ACCESS=false

# Security & Authentication
# Local API access token required for remote LAN clients (and optional local pairing).
# If left empty, a secure random token is generated at startup and logged to the console.
API_ACCESS_TOKEN=change-me-to-a-secure-random-token-at-least-32-chars
SECRET_KEY=change-me-to-a-secure-64-char-hex-secret-key-for-session-signing
VAULT_KEY_PATH=./data/database/.vault.key

# CORS Allowlist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SCAN_RATE_LIMIT_PER_MINUTE=5

# Database
DATABASE_URL=sqlite:///./data/database/cctv_assistant.db

# Network Scanning Configuration
SCAN_DEFAULT_TIMEOUT_MS=800
SCAN_MAX_CONCURRENCY=64
SCAN_PORT_TIMEOUT_MS=600
SCAN_ENABLE_ARP=true
SCAN_ENABLE_ICMP=true
SCAN_ENABLE_TCP_PROBE=true
SCAN_ENABLE_ONVIF=true
SCAN_ENABLE_MDNS=true
SCAN_ENABLE_SSDP=true
ONVIF_DISCOVERY_TIMEOUT_SECONDS=3.0
MDNS_DISCOVERY_TIMEOUT_SECONDS=2.5
SSDP_DISCOVERY_TIMEOUT_SECONDS=2.5

# Background Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=60
MONITORING_TIMEOUT_MS=1000

# Live Streaming (FFmpeg / RTSP Proxy)
FFMPEG_BINARY=ffmpeg
STREAM_MAX_FPS=15
STREAM_JPEG_QUALITY=5
STREAM_IDLE_TIMEOUT_SECONDS=45

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./data/logs/cctv_assistant.log

